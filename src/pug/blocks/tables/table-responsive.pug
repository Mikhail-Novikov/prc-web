mixin tableResponsive(colWidths = ['325px', '261px', ''], data)
  -
    var tableData = [];
    if (Array.isArray(data) && data.length && data[0] && data[0].feature) {
      tableData = [{ section: null, rows: data }];
    } else {
      tableData = data || [];
    }
    var hasNotes = false;
    for (var si = 0; si < tableData.length; si++) {
      var sec = tableData[si];
      if (sec && sec.rows) {
        for (var ri = 0; ri < sec.rows.length; ri++) {
          var r = sec.rows[ri];
          if (r && r.notes) { hasNotes = true; break; }
        }
      }
      if (hasNotes) { break; }
    }

  table.compare-table(class= hasNotes ? 'compare-table--with-analogs' : '')
    colgroup
      each width in colWidths
        if width
          col(style=`width: ${width}`)
        else
          col
    thead
      tr.compare-table__head
        th.compare-table__th Функционал
        th.compare-table__th 
          span.text-nowrap PERCo-S-20
        th.compare-table__th 
          span.text-nowrap PERCo-Web
        if hasNotes
          th.compare-table__th Поддерживаемые аналоги
    tbody
      each section in tableData
        if section.section
          -
            var sectionClasses = ['compare-table__section'];
            if (section.collapsible) { sectionClasses.push('compare-table__section--collapsible'); }
          tr(class=sectionClasses.join(' '))
            td.compare-table__cell(colspan= hasNotes ? 4 : 3)= section.section
        if section.rows
          each row in section.rows
            -
              var rowClasses = ['compare-table__row'];
              if (row.mods) { for(var i=0;i<row.mods.length;i++){ rowClasses.push('compare-table__row--' + row.mods[i]); }}
              if (row.collapsible) { rowClasses.push('compare-table__row--collapsible'); }

            tr(class=rowClasses.join(' '))
              td.compare-table__cell(data-label="Функционал")
                if typeof row.feature === 'object' && row.feature.isBoldText
                  span.text-bold= row.feature.text || row.feature.label || row.feature.value || ''
                else
                  = row.feature
              td.compare-table__cell(data-label="PERCo-S-20")
                if row.percoS && row.percoS.check
                  span.compare-table__cell--check
                else if row.percoS && Array.isArray(row.percoS)
                  each line in row.percoS
                    div.compare-table__cell--line
                      if typeof line === 'object' && line.isBoldText
                        span.text-bold= line.text || line.label || line.value || ''
                      else
                        | #{line}
                else if row.percoS && !row.percoS.check
                  |&nbsp;
              td.compare-table__cell(data-label="PERCo-Web")
                if row.percoWeb && row.percoWeb.check
                  span.compare-table__cell--check
                else if row.percoWeb && Array.isArray(row.percoWeb)
                  div.compare-table__cell--line
                    each line, idx in row.percoWeb
                      if typeof line === 'object' && line.isBoldText
                        span.text-bold= line.text || line.label || line.value || ''
                      else
                        | #{line}
                      if idx != row.percoWeb.length-1
                     
                else if row.percoWeb && !row.percoWeb.check
                  | #{row.percoWeb}
              if hasNotes
                td.compare-table__cell(data-label="Поддерживаемые аналоги")
                  div.compare-table__cell--line
                    if row.notes && Array.isArray(row.notes)
                      each n, ni in row.notes
                        if typeof n === 'object' && n.isBoldText
                          span.text-bold= n.text || n.label || n.value || ''
                        else
                          | #{n}
                        if ni != row.notes.length-1
                          br
                    else if row.notes
                      | #{row.notes}