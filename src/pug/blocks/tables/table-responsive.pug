// mixin: tableResponsive - renders the comparison table
mixin tableResponsive(colWidths = ['325px', '261px', ''])
  table.compare-table
    colgroup
      each width in colWidths
        if width
          col(style=`width: ${width}`)
        else
          col
    thead
      tr.compare-table__head
        th.compare-table__th Функционал
        th.compare-table__th PERCo-S-20
        th.compare-table__th PERCo-Web
    tbody
      tr.compare-table__section
        td(colspan="3") «Базовое ПО»
      tr.compare-table__row.compare-table__row--first-section
        td.font-weight-semibold Конфигурация оборудования
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.compare-table__row
        td.font-weight-semibold Управление устройствами
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web")
      tr.compare-table__row.compare-table__row--last-visible
        td.font-weight-semibold Добавление сотрудников
        td(data-label="PERCo-S-20") не ограничено без фотографий
        td(data-label="PERCo-Web") WB «Базовый пакет»:
          br
          | до 100 сотрудников с фотографиями
          br
          | WS «Стандартный пакет»:
          br
          | не ограничено с фотографиями
      tr(class='compare-table__row compare-table__row--collapsible')
        td.font-weight-semibold Выдача карт доступа
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='compare-table__row compare-table__row--collapsible')
        td.font-weight-semibold Добавление подразделений и должностей
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='compare-table__row compare-table__row--collapsible')
        td.font-weight-semibold Создание операторов
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='compare-table__row compare-table__row--collapsible')
        td.font-weight-semibold Управление уровнями доступа
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='compare-table__row compare-table__row--collapsible')
        td.font-weight-semibold Журнал событий
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='compare-table__row compare-table__row--collapsible')
        td.font-weight-semibold Резервное копирование данных
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WS «Стандартный пакет»
      tr.compare-table__section
        td(colspan="3") SM01 «Администратор»
      tr.compare-table__row
        td.font-weight-semibold Реакция на события
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.compare-table__row
        td.font-weight-semibold Планировщик заданий
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.compare-table__row.compare-table__row--last-visible
        td.font-weight-semibold Добавление видеокамер
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='compare-table__row compare-table__row--collapsible sm01')
        td.font-weight-semibold Настройка уведомлений
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='compare-table__row compare-table__row--collapsible sm01')
        td.font-weight-semibold Интеграция с внешними системами
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WS «Стандартный пакет»
      tr(class='compare-table__row compare-table__row--collapsible sm01')
        td.font-weight-semibold Создание отчетов
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.compare-table__section
        td(colspan="3") SM02 «Персонал»
      tr.compare-table__row
        td.font-weight-semibold Добавление фотографий сотрудников
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.compare-table__row
        td.font-weight-semibold Создание дополнительных полей
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WS «Стандартный пакет"
      tr.compare-table__row.compare-table__row--last-visible
        td.font-weight-semibold Рассылка по СМС
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='compare-table__row compare-table__row--collapsible sm02')
        td.font-weight-semibold Импорт/экспорт данных сотрудников
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет"
      tr(class='compare-table__row compare-table__row--collapsible sm02')
        td.font-weight-semibold Учет рабочего времени
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WS «Стандартный пакет"
      tr(class='compare-table__row compare-table__row--collapsible sm02')
        td.font-weight-semibold Управление временными пропусками
        td(data-label="PERCo-S-20")
          span.compare-table__cell--check
        td(data-label="PERCo-Web") WB «Базовый пакет»

  p.supported__desc--remark-text *контроллер снят с&nbsp;производства
  
  div.js-toggle-btn.toggle-section-btn 
   span.btn-text Развернуть таблицу
