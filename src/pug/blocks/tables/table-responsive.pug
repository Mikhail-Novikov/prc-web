// mixin: tableResponsive - renders the comparison table
mixin tableResponsive(colWidths = ['325px', '', ''])
  table.table
    colgroup
      each width in colWidths
        if width
          col(style=`width: ${width}`)
        else
          col
    thead
      tr.table-header
        th Функционал
        th PERCo-S-20
        th PERCo-Web
    tbody
      tr.section-header
        td(colspan="3") SN01 «Базовое ПО»
      tr.table-row.first-section
        td(data-label="Функционал") Конфигурация оборудования
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.table-row
        td(data-label="Функционал") Управление устройствами
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web")
      tr.table-row.last-visible
        td(data-label="Функционал") Добавление сотрудников
        td(data-label="PERCo-S-20") не ограничено без фотографий
        td(data-label="PERCo-Web") WB «Базовый пакет»:
          br
          | до 100 сотрудников с фотографиями
          br
          | WS «Стандартный пакет»:
          br
          | не ограничено с фотографиями
      tr(class='collapsible-row sn01')
        td(data-label="Функционал") Выдача карт доступа
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='collapsible-row sn01')
        td(data-label="Функционал") Добавление подразделений и должностей
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='collapsible-row sn01')
        td(data-label="Функционал") Создание операторов
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='collapsible-row sn01')
        td(data-label="Функционал") Управление уровнями доступа
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='collapsible-row sn01')
        td(data-label="Функционал") Журнал событий
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='collapsible-row sn01')
        td(data-label="Функционал") Резервное копирование данных
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WS «Стандартный пакет»
      tr.section-header
        td(colspan="3") SM01 «Администратор»
      tr.table-row
        td(data-label="Функционал") Реакция на события
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.table-row
        td(data-label="Функционал") Планировщик заданий
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.table-row.last-visible
        td(data-label="Функционал") Добавление видеокамер
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='collapsible-row sm01')
        td(data-label="Функционал") Настройка уведомлений
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='collapsible-row sm01')
        td(data-label="Функционал") Интеграция с внешними системами
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WS «Стандартный пакет»
      tr(class='collapsible-row sm01')
        td(data-label="Функционал") Создание отчетов
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.section-header
        td(colspan="3") SM02 «Персонал»
      tr.table-row
        td(data-label="Функционал") Добавление фотографий сотрудников
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr.table-row
        td(data-label="Функционал") Создание дополнительных полей
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WS «Стандартный пакет"
      tr.table-row.last-visible
        td(data-label="Функционал") Рассылка по СМС
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет»
      tr(class='collapsible-row sm02')
        td(data-label="Функционал") Импорт/экспорт данных сотрудников
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет"
      tr(class='collapsible-row sm02')
        td(data-label="Функционал") Учет рабочего времени
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WS «Стандартный пакет"
      tr(class='collapsible-row sm02')
        td(data-label="Функционал") Управление временными пропусками
        td(data-label="PERCo-S-20" class="checkmark") ✓
        td(data-label="PERCo-Web") WB «Базовый пакет" 

// render table with default widths (you can pass widths when including the mixin)
+tableResponsive(['325px', '', ''])
div.btn-container
  button#expanded.toggle-btn
    span.btn-text
      | Свернуть таблицу
    span.arrow
      | ▲
