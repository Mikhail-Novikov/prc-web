include lib/variables
include lib/mixins
include blocks/page

+page(pagesList.index.title)
  include ./blocks/header/_
  main#container.Site-content.main(itemprop="mainContentOfPage")
    #skd-web.skd-web

      include ./blocks/breadcrumbs/_

      section.pw-start
        div.container
          include ./blocks/pw-start/_
      
      section.profitably
        div.container
          h2 Почему стоит перейти на PERCo-Web?

          include ./blocks/profitably/_right
          include ./blocks/profitably/_left
          include ./blocks/profitably/_with-users

      section.features
        div.container
          h2 Возможности системы
          include ./blocks/features/_

      section.supported
        div.container
          h2 Поддерживаемое оборудование
          include ./blocks/supported/_

      section.comparision
        div.container
          h2 Сравнение модулей систем
          include ./blocks/comparision/_

      section.migration
        include ./blocks/content-video/_

      section.converter
        div.container
          h2 Конвертер базы данных
          include ./blocks/converter/_

  include ./blocks/footer/_