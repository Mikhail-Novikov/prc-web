include lib/variables
include lib/mixins
include blocks/page

+page(pagesList.index.title)
  include ./blocks/header/_
  main#container.Site-content.main(itemprop="mainContentOfPage")
    .skd-web
      div.container
        include ./blocks/breadcrumbs/_

        h1
          | Переход с&nbsp;системы 
          span.text-nowrap
            | S-20 
          span.text-nowrap
            | на PERCo-Web

        include ./blocks/pw-start/_

      //
      // start Advantages block
      section.profitably#anchor-1
        div.container
          h2
            | Почему стоит перейти на&nbsp;
            span.text-nowrap PERCo-Web?
          //
          // 1 
          include ./blocks/profitably/_right
          //
          // 2 
          include ./blocks/profitably/_left
          //
          // 3 
          include ./blocks/profitably/_with-users
      // end Advantages block
      //

      // start System capabilities
      // 
      section.features#anchor-4
        div.container
          h2 Возможности систем
          include ./blocks/features/_
      // end System capabilities
      // 

      // 
      // start Software block
      section.supported#anchor-2
        div.container
          h2 Поддерживаемое оборудование
          include ./blocks/supported/_
      // end Software block
      // 


      // 
      // start System capabilities
      section.comparision#anchor-5
        div.container
          h2 Сравнение модулей систем
          include ./blocks/comparision/_
      // end System capabilities
      //


      // start
      // Процедура миграции
      section.migration#anchor-3
        include ./blocks/content-video/_
      // end
      // Процедура миграции


      //
      // start
      section.converter#anchor-6
        div.container
          h2 Конвертер базы данных
          include ./blocks/converter/_
      // end
      //

  button.btn-up

  include ./blocks/footer/_